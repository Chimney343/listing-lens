# ─── Database ────────────────────────────────────────────────────────────────
# psycopg v3 DSN.  Copy this file to .env and fill in real values.
# The +psycopg driver token is required — do NOT use psycopg2.
#
# Local Pi (LAN):
DATABASE_URL=postgresql+psycopg://listings_user:secret@raspberrypi.local:5432/listing_lens
#
# Tunnel / SSH forward (e.g. ssh -L 5433:localhost:5432 pi@raspberrypi.local):
# DATABASE_URL=postgresql+psycopg://listings_user:secret@localhost:5433/listing_lens

# ─── Photo storage ───────────────────────────────────────────────────────────
# filesystem  → photos written to PHOTO_BASE_PATH on the same machine
# s3          → photos written to S3_BUCKET (activate [storage-s3] extras)
PHOTO_STORAGE_BACKEND=filesystem
PHOTO_BASE_PATH=/mnt/nvme/photos

# Only needed when PHOTO_STORAGE_BACKEND=s3:
# S3_BUCKET=listing-lens-photos
# S3_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
