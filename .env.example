# listing-lens environment template
# Copy this file to .env and adjust values for your machine.
# The project reads .env from the repository root via config/settings.py.

# Environment mode:
# development -> local runs, safer defaults
# production  -> Raspberry Pi service profile
ENV=development

# Required PostgreSQL DSN.
# Must include the +psycopg driver token.
DATABASE_URL=postgresql+psycopg://listing_lens:choose_a_password@localhost:5432/listing_lens_dev

# Logging behavior.
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
JSON_LOGS=false

# Runtime toggles.
# PII_ENABLED controls Presidio-based PII filtering in Scrapy pipelines.
# USE_DB_SLUG_QUEUE=true switches slug handoff from file mode to DB queue mode.
PII_ENABLED=true
USE_DB_SLUG_QUEUE=false

# Photo storage backend.
# filesystem -> write photos under PHOTO_BASE_PATH
# s3         -> reserved for future storage migration
PHOTO_STORAGE_BACKEND=filesystem
PHOTO_BASE_PATH=/mnt/nvme/photos

# Reserved for future S3 backend support (currently not read by config/settings.py):
# S3_BUCKET=listing-lens-photos
# S3_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
